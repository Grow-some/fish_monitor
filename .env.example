# Use synthetic only for CI or a camera-free screen check.
CAMERA_BACKEND=v4l2
CAMERA_FRAMERATE=30
CAMERA_RESTART_DELAY_SECONDS=3
CAMERA_WARMUP_FRAMES=10
CAMERA_VERTICAL_BLANKING=510
CAMERA_EXPOSURE=980
CAMERA_ANALOGUE_GAIN=306
CAMERA_ROTATION=180
RAW_AUTO_LEVELS=false
RAW_BLACK_LEVEL=0
RAW_WHITE_LEVEL=1023
RAW_AUTO_WHITE_BALANCE=false
RAW_JPEG_QUALITY=88
FRAME_STALE_SECONDS=5
WEB_HOST=0.0.0.0

# Set both values to enable HTTP Basic authentication.
# WEB_USERNAME=monitor
# WEB_PASSWORD=replace-with-a-long-password

CORRECTION_ENABLED=false
